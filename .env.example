# CookCircle voice proxy — server-side API keys (never exposed to the browser).
# Copy to `.env` and fill in. The dev server (Vite) and the standalone server
# both read these; the React client only ever calls /api/* on the same origin.

# ElevenLabs — text-to-speech. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional: voice id to use (defaults to "Rachel" 21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Sarvam — multilingual (Indian languages) text-to-speech + speech-to-text.
# https://dashboard.sarvam.ai/
SARVAM_API_KEY=

# Optional: port for the standalone server (npm run serve). Defaults to 8787.
PORT=8787
